<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>assets\LegionGoAutoRotate-AppIcon\AppIcon.ico</ApplicationIcon>
    <Version>0.3.1</Version>
    <AssemblyVersion>0.3.1.0</AssemblyVersion>
    <FileVersion>0.3.1.0</FileVersion>
    <Authors>maeinomatic</Authors>
    <Company>maeinomatic</Company>
    <Product>Legion Go Auto Rotate</Product>
    <Description>Automatic screen rotation for Lenovo Legion Go 2</Description>
    <RepositoryUrl>https://github.com/maeinomatic/LegionGoAutoRotate</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove=".tmp\**\*.cs" />
    <Compile Remove="tools\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="assets\tray-active-cropped.png" LogicalName="TrayActive" />
    <EmbeddedResource Include="assets\tray-paused-cropped.png" LogicalName="TrayPaused" />
    <EmbeddedResource Include="assets\tray-controller-blocked-cropped.png" LogicalName="TrayControllerBlocked" />
  </ItemGroup>

</Project>
